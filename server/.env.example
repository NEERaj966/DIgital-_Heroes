PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017/digital_heroes
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

ACCESS_TOKEN_SECRET=replace-with-strong-secret
ACCESS_TOKEN_EXPIRY=24h
REFRESH_TOKEN_SECRET=replace-with-strong-secret
REFRESH_TOKEN_EXPIRY=24h

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

GOOGLE_CLIENT_ID=your-google-client-id

# Razorpay Payments (subscriptions / order creation)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# RazorpayX (winner payouts)
RAZORPAYX_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAYX_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAYX_SOURCE_ACCOUNT_NUMBER=xxxxxxxxxxxxxxxx
RAZORPAYX_REQUEST_TIMEOUT_MS=15000
