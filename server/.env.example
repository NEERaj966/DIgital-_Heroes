PORT=8000
# Local MongoDB
# MONGODB_URI=mongodb://127.0.0.1:27017/digital_heroes
# Atlas MongoDB (encode special characters in password, e.g. @ -> %40)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-url>/digital_heroes?retryWrites=true&w=majority
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

ACCESS_TOKEN_SECRET=replace-with-strong-secret
ACCESS_TOKEN_EXPIRY=24h
REFRESH_TOKEN_SECRET=replace-with-strong-secret
REFRESH_TOKEN_EXPIRY=24h

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

GOOGLE_CLIENT_ID=your-google-client-id

# Stripe Checkout (subscriptions)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_PRICE_REGULAR_MONTHLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_POPULAR_MONTHLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_YEARLY=price_xxxxxxxxxxxxx
CLIENT_APP_URL=http://localhost:5173
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# RazorpayX (winner payouts)
RAZORPAYX_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAYX_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAYX_SOURCE_ACCOUNT_NUMBER=xxxxxxxxxxxxxxxx
RAZORPAYX_REQUEST_TIMEOUT_MS=15000
